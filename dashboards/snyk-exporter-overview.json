  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus"
      },
      {
        "name": "organization",
        "type": "query",
        "label": "Organization",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": "label_values(snyk_vulnerabilities_total, organization)",
        "allValue": ".*",
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "refresh": 1
      },
      {
        "name": "project",
        "type": "query",
        "label": "Project",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": "label_values(snyk_vulnerabilities_total{organization=~\"$organization\"}, project)",
        "allValue": ".*",
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "refresh": 2
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m"
}
